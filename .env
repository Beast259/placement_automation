# Email Configuration for Placement Automation System
# Copy this file to .env and fill in your actual values

# SMTP Settings (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your email credentials (use app password for Gmail)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password_here

# Email subject prefix
EMAIL_SUBJECT_PREFIX=[Placement Opportunity]

# Head of Placement Cell email (for daily reports)
HEAD_EMAIL=head_of_placement@yenepoya.edu.in

# Optional: Set to true for HTML emails (currently using plain text)
# EMAIL_IS_HTML=false